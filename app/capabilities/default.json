{
  "identifier": "default",
  "description": "Only the bundled main window may invoke the desktop application commands. Native dialogs are opened by Rust.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-daemon-status",
    "allow-ping-daemon",
    "allow-stop-daemon",
    "allow-restart-daemon",
    "allow-start-daemon-with-provider",
    "allow-get-compression-settings",
    "allow-update-compression-settings",
    "allow-get-privacy-settings",
    "allow-update-privacy-settings",
    "allow-get-notification-settings",
    "allow-update-notification-settings",
    "allow-update-network-access",
    "allow-discover-mcp-tools",
    "allow-list-mcp-servers",
    "allow-save-mcp-server",
    "allow-delete-mcp-server",
    "allow-mcp-oauth-metadata",
    "allow-sign-in-mcp-server",
    "allow-cancel-mcp-sign-in",
    "allow-get-mcp-settings",
    "allow-update-mcp-settings",
    "allow-get-telemetry-settings",
    "allow-get-telemetry-settings-with-health",
    "allow-check-telemetry-health",
    "allow-update-telemetry-settings",
    "allow-update-telemetry-settings-with-health",
    "allow-open-telemetry-ui",
    "allow-db-path",
    "allow-config-dir",
    "allow-list-integrated-apps",
    "allow-is-app-installed-cmd",
    "allow-precheck-launch-app",
    "allow-launch-app",
    "allow-pick-directory",
    "notification:default"
  ]
}
